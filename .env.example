# Configuración del agente (copiar a .env y ajustar si se necesita)
APP_NAME=Agente Persistente

# Runtime persistente del agente
# AGENT_ENABLED=false desactiva el ciclo automático; el botón manual sigue funcionando.
AGENT_ENABLED=true
# Intervalo en segundos. 600 = cada 10 minutos. Mínimo aplicado por código: 5.
AGENT_INTERVAL_SECONDS=600
# Ejecuta un ciclo apenas inicia el servidor, útil para la exposición.
AGENT_STARTUP_RUN=true

# Registro auditable de ejecuciones (JSONL). Se puede usar una ruta absoluta.
RUNS_FILE=data/agent_runs.jsonl
AGENT_MAX_SIGNAL_LIST=20
